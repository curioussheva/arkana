# ─── Dependencies ────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Expo ────────────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ─── Native (generated by prebuild / EAS Build) ─────────────────
android/
ios/

# ─── Metro / bundler cache ───────────────────────────────────────
.metro-health-check*
*.jsbundle

# ─── Local env & secrets ─────────────────────────────────────────
.env
.env.local
.env*.local
*.pem
*.jks
*.keystore

# ─── SQLite dev databases (do NOT commit local data) ─────────────
*.db
*.db-journal
*.db-wal
*.db-shm
src/db/local.db

# ─── Drizzle migrations output (uncomment if you want to gitignore
# generated SQL migrations too — usually you DO want these committed,
# so leave this commented unless you regenerate them per-environment)
# src/db/migrations/

# ─── Testing ───────────────────────────────────────────────────
coverage/

# ─── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# ─── macOS / OS junk ──────────────────────────────────────────────
.DS_Store
*.pem
.idea/
.vscode/
*.swp

# ─── TypeScript build info ────────────────────────────────────────
*.tsbuildinfo

# ─── EAS local build artifacts ────────────────────────────────────
*.apk
*.aab
*.ipa
credentials.json
 