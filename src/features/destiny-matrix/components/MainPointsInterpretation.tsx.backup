// src/features/destiny-matrix/components/MainPointsInterpretation.tsx

import React, { useMemo } from 'react';
import { View, Text, StyleSheet } from 'react-native';
import { useThemeStore } from '@store/theme-store';
import { SPACING, FONT_SIZE, BORDER_RADIUS } from '@constants/theme';
import type { DestinyMatrix, DestinyPointKey } from '@core/destiny-matrix/types';

interface MainPointsInterpretationProps {
  matrix: DestinyMatrix | null | undefined;
}

interface PointConfig {
  key: DestinyPointKey;
  title: string;
  subtitle: string;
  iconBg: string;
}

// Konfigurasi titik utama takdir untuk interpretasi naratif
const POINT_CONFIGS: PointConfig[] = [
  {
    key: 'A',
    title: 'Hari Lahir (Karakter / Mental)',
    subtitle: 'Energi dasar diri, bagaimana ego Anda terbentuk & berinteraksi.',
    iconBg: '#E74C3C',
  },
  {
    key: 'B',
    title: 'Bulan Lahir (Spiritual / Malaikat Pelindung)',
    subtitle: 'Saluran intuisi tertinggi dan koneksi spiritualitas jiwa.',
    iconBg: '#9B59B6',
  },
  {
    key: 'E',
    title: 'Pusat Jiwa (Comfort Zone)',
    subtitle: 'Inti energi penyeimbang; sumber kekuatan sejati Anda.',
    iconBg: '#F1C40F',
  },
  {
    key: 'C',
    title: 'Tahun Lahir (Material / Finansial)',
    subtitle: 'Gerbang manifestasi kemakmuran dan realisasi karier duniawi.',
    iconBg: '#2ECC71',
  },
  {
    key: 'D',
    title: 'Ekor Karma (Pelajaran Masa Lalu)',
    subtitle: 'Tantangan bawah sadar bawaan yang perlu disembuhkan.',
    iconBg: '#34495E',
  },
];

export function MainPointsInterpretation({ matrix }: MainPointsInterpretationProps) {
  const colors = useThemeStore((s) => s.getColors());

  const interpretedPoints = useMemo(() => {
    if (!matrix?.points) return [];

    return POINT_CONFIGS.map((config) => {
      const pointData = matrix.points[config.key];
      if (!pointData) return null;

      const arcana = pointData.arcana;
      
      // Mengambil teks naratif secara aman dari properti summary atau narrative overview
      const interpretationText = 
        arcana?.summary || 
        arcana?.narrative?.overview || 
        arcana?.uprightMeaning || 
        'Interpretasi energi spiritual sedang dikalkulasi...';

      return {
        ...config,
        value: pointData.value,
        arcanaName: arcana?.matrixName || arcana?.tarotName || 'Arcana Rahasia',
        text: interpretationText,
      };
    }).filter((p): p is NonNullable<typeof p> => p !== null);
  }, [matrix]);

  if (!matrix) return null;

  return (
    <View style={styles.container}>
      <View style={styles.headerRow}>
        <Text style={[styles.sectionTitle, { color: colors.text }]}>
          📍 Interpretasi Titik Utama
        </Text>
      </View>

      {interpretedPoints.map((item) => (
        <View 
          key={`interpret-${item.key}`} 
          style={[styles.card, { backgroundColor: colors.surface, borderColor: colors.border + '30' }]}
        >
          <View style={styles.cardHeader}>
            <View style={[styles.badgeIcon, { backgroundColor: item.iconBg }]}>
              <Text style={styles.badgeText}>{item.key}</Text>
            </View>
            <View style={styles.titleBlock}>
              <Text style={[styles.pointTitle, { color: colors.text }]}>
                {item.title}
              </Text>
              <Text style={[styles.arcanaLabel, { color: colors.primary }]}>
                Arcana {item.value} • {item.arcanaName}
              </Text>
            </View>
          </View>

          <Text style={[styles.subtitle, { color: colors.textSecondary }]}>
            {item.subtitle}
          </Text>

          <View style={[styles.divider, { backgroundColor: colors.border + '20' }]} />

          <Text style={[styles.bodyText, { color: colors.text }]}>
            {item.text}
          </Text>
        </View>
      ))}
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    marginTop: SPACING.md,
    paddingHorizontal: SPACING.sm,
  },
  headerRow: {
    marginBottom: SPACING.md,
    flexDirection: 'row',
    alignItems: 'center',
  },
  sectionTitle: {
    fontSize: FONT_SIZE.lg,
    fontWeight: '700',
  },
  card: {
    borderRadius: BORDER_RADIUS.lg,
    padding: SPACING.md,
    marginBottom: SPACING.md,
    borderWidth: 1,
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.05,
    shadowRadius: 8,
    elevation: 2,
  },
  cardHeader: {
    flexDirection: 'row',
    alignItems: 'center',
  },
  badgeIcon: {
    width: 36,
    height: 36,
    borderRadius: 18,
    justifyContent: 'center',
    alignItems: 'center',
    marginRight: SPACING.sm,
  },
  badgeText: {
    color: '#FFF',
    fontWeight: '800',
    fontSize: FONT_SIZE.md,
  },
  titleBlock: {
    flex: 1,
  },
  pointTitle: {
    fontSize: FONT_SIZE.md,
    fontWeight: '700',
  },
  arcanaLabel: {
    fontSize: FONT_SIZE.sm,
    fontWeight: '600',
    marginTop: 2,
  },
  subtitle: {
    fontSize: FONT_SIZE.xs,
    fontStyle: 'italic',
    marginTop: SPACING.xs,
    paddingLeft: 44,
  },
  divider: {
    height: 1,
    marginVertical: SPACING.sm,
    marginLeft: 44,
  },
  bodyText: {
    fontSize: FONT_SIZE.md,
    lineHeight: 22,
    marginLeft: 44,
    textAlign: 'justify',
  },
});
